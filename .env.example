# Umgebungsvariablen, Stand 25.09.2026.
# Lokal als .env.local anlegen, ohne Produktionsschlüssel. In Vercel im Projekt setzen.
# Werte nie ins Repository schreiben.

# Kontaktformular (M04). Ohne Schlüssel wird nichts versendet, das Formular meldet dann einen Fehler.
RESEND_API_KEY=
# Empfänger der Anfragen. Ohne Angabe admin@brandea.de (E15), zum Launch die Adresse des Kunden.
CONTACT_TO_EMAIL=
# Absender. Die Domain muss in Resend verifiziert sein. Ohne Angabe website@brandea.de.
CONTACT_FROM_EMAIL=
# Nur für Tests gegen einen Nachbau der Resend-API, zum Beispiel http://127.0.0.1:8025
# RESEND_BASE_URL=

# Name (E38): Mantena und Clavea erst nach der Markenrecherche öffentlich. Ohne Angabe gilt in der
# Vercel-Produktion die Arbeitsmarke «BGS Gebäudeservice», in Previews und lokal der neue Name.
# Nach der Markenrecherche in der Produktion auf true setzen. false zeigt überall die Arbeitsmarke.
NEW_BRAND=

# Suchmaschinen (M08): Ohne true tragen alle Seiten noindex. Nur in Produktion und erst zum Launch setzen.
SITE_INDEXABLE=
# Kanonische Adresse für Canonicals und Sitemap, zum Launch zum Beispiel https://mantena.ch
NEXT_PUBLIC_SITE_URL=

# KI-Chat erst nach der Reparatur einschalten (M03)
NEXT_PUBLIC_CHAT_ENABLED=false
GEMINI_API_KEY=

# Bilder erst nach Freigabe neuer Bilder einschalten, sonst neutrale Platzhalter (M13)
NEXT_PUBLIC_REAL_IMAGES=false
